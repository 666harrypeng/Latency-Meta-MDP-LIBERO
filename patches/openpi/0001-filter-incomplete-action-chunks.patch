         return len(self._dataset)


+class EpisodeTailFilteredDataset(Dataset[T_co]):
+    """Index view that excludes a fixed number of source frames per episode."""
+
+    def __init__(self, dataset: Dataset[T_co], *, drop_n_last_frames: int):
+        if (
+            isinstance(drop_n_last_frames, bool)
+            or not isinstance(drop_n_last_frames, int)
+            or drop_n_last_frames < 0
+        ):
+            raise ValueError("drop_n_last_frames must be a non-negative integer")
+        episode_data_index = typing.cast(typing.Any, dataset).episode_data_index
+        indices: list[int] = []
+        for start, end in zip(
+            episode_data_index["from"], episode_data_index["to"], strict=True
+        ):
+            start_index = int(start.item())
+            end_index = int(end.item())
+            if end_index - start_index <= drop_n_last_frames:
+                raise ValueError("drop_n_last_frames leaves an episode with no valid source frames")
+            indices.extend(range(start_index, end_index - drop_n_last_frames))
+        self._dataset = dataset
+        self._indices = tuple(indices)
+
+    def __getitem__(self, index: SupportsIndex) -> T_co:
+        return self._dataset[self._indices[index.__index__()]]
+
+    def __len__(self) -> int:
+        return len(self._indices)
+
+
