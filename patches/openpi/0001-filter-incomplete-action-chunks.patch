@@ -1,12 +1,46 @@
 import dataclasses
+import typing
 
 import jax
+import pytest
+import torch
 
 from openpi.models import pi0_config
 from openpi.training import config as _config
 from openpi.training import data_loader as _data_loader
 
 
+class _EpisodeIndexedDataset:
+    episode_data_index: typing.ClassVar = {
+        "from": torch.tensor([0, 5]),
+        "to": torch.tensor([5, 9]),
+    }
+
+    def __getitem__(self, index):
+        return int(index)
+
+    def __len__(self):
+        return 9
+
+
+def test_episode_tail_filtered_dataset_drops_source_indices_per_episode():
+    dataset = _data_loader.EpisodeTailFilteredDataset(
+        _EpisodeIndexedDataset(),
+        drop_n_last_frames=2,
+    )
+
+    assert len(dataset) == 5
+    assert [dataset[index] for index in range(len(dataset))] == [0, 1, 2, 5, 6]
+
+
+def test_episode_tail_filtered_dataset_rejects_an_episode_without_a_valid_source():
+    with pytest.raises(ValueError, match="no valid source frames"):
+        _data_loader.EpisodeTailFilteredDataset(
+            _EpisodeIndexedDataset(),
+            drop_n_last_frames=4,
+        )
+
+
 def test_torch_data_loader():
     config = pi0_config.Pi0Config(action_dim=24, action_horizon=50, max_token_len=48)
     dataset = _data_loader.FakeDataset(config, 16)
