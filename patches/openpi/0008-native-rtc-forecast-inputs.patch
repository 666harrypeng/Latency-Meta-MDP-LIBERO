diff --git a/src/openpi/models/tokenizer.py b/src/openpi/models/tokenizer.py
--- a/src/openpi/models/tokenizer.py
+++ b/src/openpi/models/tokenizer.py
@@ -46,6 +46,33 @@
             mask = [True] * self._max_len
 
         return np.asarray(tokens), np.asarray(mask)
+
+
+    def tokenize_forecast(self, prompt, state, *, future_state, query_ticks):
+        """Use the native vocabulary for explicit current/future roles; never truncate."""
+        if type(query_ticks) is not int or not 0 <= query_ticks <= 20:
+            raise ValueError("forecast query must be an integer in0..20")
+
+        def state_text(value):
+            value = np.asarray(value)
+            if value.shape != (16,) or not np.isfinite(value).all():
+                raise ValueError("forecast tokenizer requires finite normalized16D states")
+            bins = np.digitize(value, bins=np.linspace(-1, 1, 256 + 1)[:-1]) - 1
+            return " ".join(map(str, bins))
+
+        cleaned = prompt.strip().replace("_", " ").replace("\n", " ")
+        future = "unavailable" if future_state is None else state_text(future_state)
+        text = (
+            f"Task: {cleaned}, State: {state_text(state)}; "
+            "Images: current main, current wrist, forecast main, forecast wrist. "
+            f"Forecast horizon: {query_ticks * 20} ms; Forecast state: {future};\nAction: "
+        )
+        tokens = self._tokenizer.encode(text, add_bos=True)
+        if len(tokens) > self._max_len:
+            raise ValueError(f"forecast tokens would truncate: {len(tokens)} > {self._max_len}")
+        count = len(tokens)
+        return (np.asarray(tokens + [0] * (self._max_len - count), dtype=np.int32),
+                np.arange(self._max_len) < count)
 
 
