+def _checkpoint_save_step(
+    *,
+    completed_step: int,
+    num_train_steps: int,
+    save_interval: int,
+) -> int | None:
+    if completed_step <= 0:
+        raise ValueError("completed_step must be positive")
+    if num_train_steps <= 0 or completed_step > num_train_steps:
+        raise ValueError("completed_step must not exceed num_train_steps")
+    if save_interval <= 0:
+        raise ValueError("save_interval must be positive")
+    if completed_step % save_interval == 0 or completed_step == num_train_steps:
+        return completed_step
+    return None
+
